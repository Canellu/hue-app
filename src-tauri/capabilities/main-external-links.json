{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-external-links",
  "description": "Allow the main window to open only Mote Desktop public pages",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://motedesktop.com/privacy" },
        { "url": "https://motedesktop.com/terms" },
        { "url": "https://motedesktop.com/support" },
        { "url": "https://motedesktop.com/releases" }
      ]
    }
  ]
}
